<?xml version="1.0" encoding="utf-8"?>
<!--
  Console packaging input only. The secure Xbox GDK and Partner Center supply
  the real identity and TargetDeviceFamily. Never guess or publish those values.
-->
<Game configVersion="1">
  <Identity Name="@PARTNER_CENTER_IDENTITY_NAME@"
            Publisher="@PARTNER_CENTER_PUBLISHER@"
            Version="@PACKAGE_VERSION@"/>
  <Resources>
    <Resource Language="en-US"/>
  </Resources>
  <ExecutableList>
    <Executable Name="@EXECUTABLE_NAME@.exe"
                Id="Game"
                Alias="@PARTNER_CENTER_IDENTITY_ALIAS@.exe"
                OverrideDisplayName="@DISPLAY_NAME@"
                TargetDeviceFamily="@XBOX_TARGET_DEVICE_FAMILY@"/>
  </ExecutableList>
  <ShellVisuals DefaultDisplayName="@DISPLAY_NAME@"
                PublisherDisplayName="@PARTNER_CENTER_PUBLISHER_DISPLAY_NAME@"
                StoreLogo="StoreLogo.png"
                Square150x150Logo="Logo.png"
                Square44x44Logo="SmallLogo.png"
                Square480x480Logo="LargeLogo.png"
                SplashScreenImage="SplashScreen.png"
                Description="@DESCRIPTION@"
                BackgroundColor="#000000"
                ForegroundText="light"/>
</Game>
